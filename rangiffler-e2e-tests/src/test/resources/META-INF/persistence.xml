<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd"
             version="2.1">
    <persistence-unit name="rangiffler-auth" transaction-type="JTA">
        <jta-data-source>java:comp/env/jdbc/rangiffler-auth</jta-data-source>
        <class>guru.qa.rangiffler.data.entity.auth.AuthorityEntity</class>
        <class>guru.qa.rangiffler.data.entity.auth.AuthUserEntity</class>

        <properties>
            <property name="hibernate.transaction.jta.platform" value="com.atomikos.icatch.jta.hibernate4.AtomikosPlatform"/>
            <property name="hibernate.connection.handling_mode" value="DELAYED_ACQUISITION_AND_RELEASE_AFTER_STATEMENT"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="rangiffler-userdata" transaction-type="JTA">
        <jta-data-source>java:comp/env/jdbc/rangiffler-userdata</jta-data-source>
        <class>guru.qa.rangiffler.data.entity.userdata.UdUserEntity</class>
        <class>guru.qa.rangiffler.data.entity.userdata.FriendshipEntity</class>

        <properties>
            <property name="hibernate.transaction.jta.platform" value="com.atomikos.icatch.jta.hibernate4.AtomikosPlatform"/>
            <property name="hibernate.connection.handling_mode" value="DELAYED_ACQUISITION_AND_RELEASE_AFTER_STATEMENT"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="rangiffler-countries" transaction-type="JTA">
        <jta-data-source>java:comp/env/jdbc/rangiffler-countries</jta-data-source>
        <class>guru.qa.rangiffler.data.entity.countries.CountryEntity</class>

        <properties>
            <property name="hibernate.transaction.jta.platform" value="com.atomikos.icatch.jta.hibernate4.AtomikosPlatform"/>
            <property name="hibernate.connection.handling_mode" value="DELAYED_ACQUISITION_AND_RELEASE_AFTER_STATEMENT"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
        </properties>
    </persistence-unit>

    <persistence-unit name="rangiffler-photos" transaction-type="JTA">
        <jta-data-source>java:comp/env/jdbc/rangiffler-spend</jta-data-source>
        <class>guru.qa.rangiffler.data.entity.photos.PhotoEntity</class>
        <class>guru.qa.rangiffler.data.entity.photos.PhotoLikeEntity</class>
        <class>guru.qa.rangiffler.data.entity.photos.StatisticEntity</class>

        <properties>
            <property name="hibernate.transaction.jta.platform" value="com.atomikos.icatch.jta.hibernate4.AtomikosPlatform"/>
            <property name="hibernate.connection.handling_mode" value="DELAYED_ACQUISITION_AND_RELEASE_AFTER_STATEMENT"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
        </properties>
    </persistence-unit>

</persistence>