scalar Date

type Query {
    session: Session!
    countries: [Country!]!
    country(code: String, id: String): Country!
    user: User!
    users(page:Int = 0, size:Int = 10, searchQuery:String): UsersSlice
    feed(page:Int = 0, size:Int = 12, withFriends: Boolean!): Feed!
}

type Mutation {
    user(input: UserInput!): User!
    friendship(input: FriendshipInput!): User!
    photo(input: PhotoInput!): Photo!
    deletePhoto(id: ID!): String
}

type Session {
    username: String
    issuedAt: Date
    expiresAt: Date
}

type User {
    id: ID!
    username: String
    firstname: String
    surname: String
    avatar: String
    friendStatus: FriendStatus
    friends(page:Int = 0, size:Int = 10, searchQuery:String): UsersSlice
    incomeInvitations(page:Int = 0, size:Int = 10, searchQuery:String): UsersSlice
    outcomeInvitations(page:Int = 0, size:Int = 10, searchQuery:String): UsersSlice
    location: UserLocation
}

type UserLocation {
    flag: String!
    code: String!
    name: String!
}

type Feed {
    username: String!
    withFriends: Boolean!
    photos(page:Int, size:Int): PhotoSlice
    stat: [Stat!]
}

type PhotoSlice {
    content: [Photo]!
    pageInfo: PageInfo!
}

type UsersSlice {
    content: [User]!
    pageInfo: PageInfo!
}

type PageInfo {
    hasNextPage: Boolean!
    hasPreviousPage: Boolean!
}

type Stat {
    count: Int!
    country: Country!
}

type Photo {
    id: ID!
    user: User
    src: String!
    country: Country!
    description: String!
    creationDate: Date!
    likes: Likes
}

type Likes {
    total: Int!
    likes: [Like!]
}

type Like {
    user: ID!
}

type Country {
    id: String!
    flag: String!
    code: String!
    name: String!
}

input FriendshipInput {
    user: ID!
    action: FriendshipAction!
}

input PhotoInput {
    id: ID
    src: String
    country: CountryInput
    description: String
    like: LikeInput
}

input LikeInput {
    user: ID!
}

input UserInput {
    firstname: String
    surname: String
    avatar: String
    location: CountryInput
}

input CountryInput {
    code: String!
}

enum FriendshipAction {
    ADD, ACCEPT, REJECT, DELETE
}

enum FriendStatus {
    NOT_FRIEND, INVITATION_SENT, INVITATION_RECEIVED, FRIEND
}
